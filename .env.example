# Cypress Environment Variables
# Copy this file to .env and customize as needed

# Base URL for testing
CYPRESS_BASE_URL=https://the-internet.herokuapp.com

# Cypress Dashboard (optional)
# CYPRESS_RECORD_KEY=your-record-key-here

# Environment selection (dev, staging, prod)
CYPRESS_ENV=local

# Timeouts (in milliseconds)
CYPRESS_DEFAULT_COMMAND_TIMEOUT=10000
CYPRESS_PAGE_LOAD_TIMEOUT=60000

# Video and screenshots
CYPRESS_VIDEO=true
CYPRESS_SCREENSHOT_ON_RUN_FAILURE=true

# Viewport settings
CYPRESS_VIEWPORT_WIDTH=1280
CYPRESS_VIEWPORT_HEIGHT=720
